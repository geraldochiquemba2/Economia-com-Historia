generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("student") // 'admin' or 'student'
  profession    String   @default("Estudante") // 'Docente', 'Estudante', 'Trabalhador'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Content {
  id          String   @id @default(uuid())
  type        String   // "video", "text", "podcast", "jindungo"
  title       String
  description String
  thumbnail   String
  fullText    String
  videoUrl    String?  // URL do YouTube ou outro vídeo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
