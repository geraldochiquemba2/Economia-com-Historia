generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("student") // 'admin' or 'student'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
